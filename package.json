    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@huggingface/transformers": "^4.3.1",
    "@shikijs/langs": "^4.5.0",
    "pdfjs-dist": "^6.4.299",
    "rxjs": "~7.8.0",
    "shiki": "^4.5.0",
    "tesseract.js": "^7.0.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.0",
    "@tailwindcss/postcss": "^4.2.2",
    "autoprefixer": "^10.4.27",
